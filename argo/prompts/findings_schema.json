{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecurityFindings",
  "description": "Normalized findings emitted by the audit stage. One file per audit focus; merged + deduped + validated downstream.",
  "type": "object",
  "required": ["program_name", "audit_focus", "generated_at", "findings"],
  "properties": {
    "program_name": { "type": "string" },
    "audit_focus": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "confidence", "cwe", "affected", "vulnerable_flow", "why_vulnerable", "exploit_scenario", "impact", "recommended_fix"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._#-]{0,127}$", "description": "Stable within a run, e.g. AUTHZ-001" },
          "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low", "Informational"] },
          "confidence": { "type": "string", "enum": ["Confirmed", "High", "Medium", "Low"] },
          "cwe": { "type": "string", "description": "e.g. CWE-89" },
          "owasp": { "type": "string", "description": "OWASP category or closest equivalent" },
          "affected": {
            "type": "array",
            "items": { "type": "string", "description": "file:line / class / function / component" },
            "minItems": 1
          },
          "vulnerable_flow": { "type": "string", "description": "source -> ... -> sink with refs" },
          "why_vulnerable": { "type": "string" },
          "exploit_scenario": { "type": "string" },
          "impact": { "type": "string" },
          "recommended_fix": { "type": "string", "description": "Guidance only; pipeline does not patch." },
          "claim": { "type": "string", "description": "Exact security claim, separate from severity/confidence." },
          "attacker_start": { "type": "string", "description": "Attacker identity, access and control at the start of the path." },
          "attack_context": {
            "type": "object",
            "description": "Optional explicit compatibility dimensions for evidence-gated path composition. Use exact values from source/scope; use 'unknown' rather than guessing. A path is never composed across unknown or mismatched dimensions.",
            "additionalProperties": false,
            "required": ["principal", "tenant_scope", "deployment_scope", "configuration_scope"],
            "properties": {
              "principal": { "type": "string" },
              "tenant_scope": { "type": "string" },
              "deployment_scope": { "type": "string" },
              "configuration_scope": { "type": "string" }
            }
          },
          "preconditions": {
            "type": "array", "items": { "type": "string" },
            "description": "Deployment, configuration, identity and state assumptions required by the claim."
          },
          "capabilities_gained": {
            "type": "array", "items": { "type": "string" },
            "description": "Concrete attacker capabilities established if the claim holds."
          },
          "proof_obligations": {
            "type": "array",
            "description": "Conditions still requiring proof. Audit may emit concise strings; the deterministic evidence stage canonicalizes them.",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object", "required": ["id", "description"],
                  "properties": {
                    "id": { "type": "string" }, "description": { "type": "string" },
                    "status": { "type": "string", "enum": ["open", "satisfied", "contradicted", "not_applicable"] },
                    "evidence_ids": { "type": "array", "items": { "type": "string" } },
                    "reason": { "type": ["string", "null"] }
                  }
                }
              ]
            }
          },
          "evidence": {
            "type": "array",
            "description": "Canonical normalized proof records; richer native stage artifacts remain in their original fields/files.",
            "items": {
              "type": "object", "required": ["id", "source", "kind", "polarity", "summary"],
              "properties": {
                "id": { "type": "string" },
                "source": { "type": "string", "enum": ["audit", "validation", "corroboration", "deep_verify", "asan", "runtime", "live", "maintainer"] },
                "kind": { "type": "string" },
                "polarity": { "type": "string", "enum": ["supports", "contradicts", "inconclusive"] },
                "summary": { "type": "string" }, "artifact": { "type": ["string", "null"] },
                "decisive_observation": { "type": ["string", "null"] },
                "negative_control": { "type": ["string", "null"] },
                "obligations_satisfied": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "remaining_uncertainty": { "type": "array", "items": { "type": "string" } },
          "proof_level": {
            "type": "string",
            "enum": ["hypothesis", "source_supported", "independently_rederived", "runtime_observed", "end_to_end_proven"]
          },
          "claim_status": { "type": "string", "enum": ["active", "refuted", "conflicted"] },
          "external_status": { "type": "string", "enum": ["unknown", "accepted", "rejected"] },
          "consistency_issues": {
            "type": "array",
            "items": {
              "type": "object", "required": ["code", "severity", "message"],
              "properties": {
                "code": { "type": "string" }, "severity": { "type": "string", "enum": ["warning", "error"] },
                "message": { "type": "string" },
                "evidence_ids": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "threat_model_class": { "type": "string", "description": "OPTIONAL. One of: real_bug (holds regardless of trust model) | broken_mechanism (defeats a security control the project itself ships) | by_design (intended within the stated trust model)." },
          "affected_build_config": { "type": "string", "description": "OPTIONAL. The build/config the finding applies to (e.g. 'default' vs a specific hardening flag). Empty if not config-dependent." },
          "action_plan": { "type": "string" },
          "missing_tests": { "type": "string" },
          "variants": { "type": "string", "description": "Where similar patterns may exist + where the author checked" },
          "live_verification_plan": { "type": "string", "description": "Safe, in-scope, non-DoS steps for a human. Only for source_and_live targets." },
          "dedup_key": { "type": "string", "description": "Computed downstream: hash of normalized(file + primary_line + cwe). Not set by audit stage." },
          "validation": {
            "type": "object",
            "description": "Filled by the adversarial validation stage; absent until validated.",
            "properties": {
              "verdict": { "type": "string", "enum": ["confirmed", "refuted", "needs_runtime_verification", "out_of_scope"] },
              "validated_confidence": { "type": "string", "enum": ["Confirmed", "High", "Medium", "Low"] },
              "validated_severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low", "Informational"] },
              "rationale": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
